# Server
PORT=8080
NODE_ENV=development
# Comma-separated list of browser origins allowed by CORS (leave empty to disable CORS)
CORS_ORIGINS=http://localhost:3000

# Auth: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Token / cookie lifetime in seconds
JWT_EXPIRES_IN=3600

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=authentication_development
DB_USER=
DB_PASSWORD=
# Set to true to require TLS to the database in production
DB_SSL=false
